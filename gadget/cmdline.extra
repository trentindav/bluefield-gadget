# Modify kernel boot parameters, reference: https://ubuntu.com/core/docs/modify-kernel-options

# Console output via rshim fs
console=hvc0
# Support console output via obmc console, required to show the UC configuration dialogue
console=ttyAMA0
# earlycon messages are enabled for development and debugging
#earlycon=pl011,0x13010000
earlycon=pl011,0x09000000
# hugepages
hugepagesz=512M
hugepages=10
hugepagesz=2M
hugepages=4096
